<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"> -->
    <title>Szabadsag Igénylés</title>
</head>

<body>
    <div class="container">
        <h1>Szabadság Igénylés</h1>
        <% if (locals.errors && locals.errors.length> 0) { %>
            <!-- <div> -->
            <ul>
                <% locals.errors.forEach(e=> { %>

                    <li>
                        <%= e %>
                    </li>

                    <% }); %>
            </ul>
            <!-- </div> -->
            <% } %>
                <ul>
                    <% if (locals.success) { %>
                        <!-- <div> -->

                        <li> Az igénylés sikeresen elküldve </li>

                        <!-- </div> -->
                        <% } %>
                </ul>

                <form method="post">
                    <label for="nev">Teljes név:</label> <br>
                    <input type="text" id="nev" name="nev"> <!--value=' locals.?body.nev : "" ' --> <br>

                    <label for="kezdoDate">Adja meg az igényelt szabadság kezdetének a dátumát</label> <br>
                    <input type="date" id="kezdoDate" name="kezdoDate"> <!-- value=" body.?kezdoDate : "" %>"-->
                    <br>

                    <label for="vegDate">Adja meg az igényelt szabadság végzetének a dátumát</label> <br>
                    <input type="date" id="vegDate" name="vegDate"> <!--value=" body.?vegDate : "" %>"--> <br>

                    <label for="fizetett">Jelölje be ha az ígénylés fizetett szabadságra szeretné
                        benyújtani</label> <br>
                    <input type="checkbox" id="fizetett" name="fizetett"> <!--value=" body.?fizetett : "" %>"-->
                    <br>

                    <label for="azonosito">Írja be az alkalmazott azonosítóját</label> <br>
                    <input type="text" id="azonosito" name="azonosito" placeholder="abc-123">
                    <!--value=" body.?azonosito : "" %>"--> <br>

                    <label for="indoklas">Írja be az indoklást miért küldi ezt az igénylést (minimum 30
                        karakter)</label> <br>
                    <input type="text" id="indoklas" name="indoklas"> <!--value=" body.?indoklas : ""  %>"-->
                    <br>

                    <input type="submit" value="Elküldés">
                </form>
    </div>
</body>

</html>